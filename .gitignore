# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
#
# This read ".env*.local" only, which ignores .env.local and .env.production.local
# and lets plain .env, .env.production and .env.development through — the exact
# filenames anyone reaching for a local copy of production credentials would
# use. Nothing has been committed (checked across the whole history for key
# shapes and for the admin secret), but during a credential breach the gap is
# worth closing rather than relying on nobody having tripped over it.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
